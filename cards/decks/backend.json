    "id": "309715d090d9",
    "deck": "backend",
    "tags": [
      "backend",
      "resilience"
    ],
    "front": "Circuit breaker state machine?",
    "back": "CLOSED → failures ≥ threshold → OPEN (fail fast) → after timeout → HALF-OPEN (probe) → success → CLOSED; failure → OPEN",
    "source": "doc/backend/DRILL_CONCEPTS.md",
    "section": "Circuit breaker"
  },
  {
    "id": "faac54bbe260",
    "deck": "backend",
    "tags": [
      "backend",
      "resilience"
    ],
    "front": "Exponential backoff formula + rules?",
    "back": "delay = min(cap, base * 2^attempt) + jitter. Only retry transient errors. Require idempotent ops or Idempotency-Key.",
    "source": "doc/backend/DRILL_CONCEPTS.md",
    "section": "Retry"
  },
